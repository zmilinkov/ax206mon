[Unit]
Description=Status dashboard on an AX206 USB mini display
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/ax206mon run
User=ax206mon
Group=ax206mon
SupplementaryGroups=docker
# The program itself waits for the display and survives unplugging;
# this only covers crashes and config errors.
Restart=on-failure
RestartSec=10

# Hardening. The process needs: read /proc and /sys, read /etc/ax206mon,
# read/write USB device nodes (/dev/bus/usb, char major 189) and, for the
# docker pages, access to /var/run/docker.sock (add the user to `docker`).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=char-usb_device rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# CAP_PERFMON lets the Intel GPU engine counters (i915 PMU) be read.
AmbientCapabilities=CAP_PERFMON
CapabilityBoundingSet=CAP_PERFMON
UMask=0077

[Install]
WantedBy=multi-user.target
